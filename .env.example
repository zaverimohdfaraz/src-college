# ---- Email (Nodemailer / SMTP) ----
# Gmail / Google Workspace: host smtp.gmail.com, port 465, and an App Password
# (Google Account → Security → 2-Step Verification → App passwords), not the normal password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
# true for port 465, false for 587 (STARTTLS). Leave blank to decide from the port.
SMTP_SECURE=""
SMTP_USER="website@sr-college.com"
SMTP_PASS="app-password-here"

# Who receives enquiries. Separate several addresses with commas.
ENQUIRY_TO="info@sr-college.com"
# Sender shown on the emails. Must be the SMTP account or an alias it is allowed to send as.
MAIL_FROM="\"SRCC Website\" <website@sr-college.com>"
# Send a short "we have received your enquiry" email to the person who filled the form.
SEND_AUTO_REPLY="true"

# Public base URL used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL="https://sr-college.com"
